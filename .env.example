# Anthropic Claude API Configuration
# Required for live Claude models (claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
# If left empty, deterministic mock providers will run automatically for offline tests and evaluation.
ANTHROPIC_API_KEY=

# Task 1: Knowledge Brain Configuration
TASK1_HOST=127.0.0.1
TASK1_PORT=8001
TASK1_DB_PATH=task1_knowledge_brain/data/knowledge_brain.db
TASK1_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
TASK1_CRAWL_BATCH_SIZE=20
TASK1_CRAWL_DELAY_SEC=0.2

# Task 2: Inbox Agent Configuration
TASK2_PORT=3000
TASK1_API_URL=http://127.0.0.1:8001
TASK2_STORAGE_DIR=task2_inbox_agent/data

# Task 3: Meeting-to-Scope Configuration
TASK3_STORAGE_DIR=task3_meeting_to_scope/data
