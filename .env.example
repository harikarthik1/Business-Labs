# Anthropic Claude API Configuration
# Optional for live Claude models (claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
# If left empty, deterministic mock providers run automatically for offline tests and evaluation.
ANTHROPIC_API_KEY=

# Task 1: Knowledge Brain Server Configuration
TASK1_HOST=127.0.0.1
TASK1_PORT=8001
TASK1_DB_PATH=task1_knowledge_brain/data/knowledge_brain.db

# Documentation Ingestion & Crawler Configuration
TASK1_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
TASK1_CRAWL_BATCH_SIZE=20
TASK1_CRAWL_DELAY_SEC=0.2
